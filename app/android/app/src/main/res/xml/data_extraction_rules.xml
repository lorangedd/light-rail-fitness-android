<?xml version="1.0" encoding="utf-8"?>
<!-- 修改时间：2026-08-20 15:46:01 +08:00；目的：禁止系统云备份和设备迁移导出应用内训练数据。 -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
